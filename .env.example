# ==============================================================================
# Crunchy Code Bookstore Backend - Environment Configuration (.env.example)
# Instructions: Copy this file to '.env' for local development or container deployment:
#   cp .env.example .env
# ==============================================================================

# Server Runtime Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (MySQL 8)
# If deploying to Railway or Render, set MYSQL_URL or DATABASE_URL:
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crunchy_bookstore
DB_USER=crunchy_dev
DB_PASSWORD=crunchy_dev_secret_2026

# JWT Security & Encryption
# Cryptographically strong 256-bit HMAC-SHA256 secret (64 hexadecimal characters)
# For production environments, generate via: openssl rand -hex 32
JWT_SECRET=c8f9b2d3e4a5f601728394a5b6c7d8e9f0123456789abcdef0123456789abcdef

# JWT Token Expiration in milliseconds (86400000 ms = 24 Hours)
# Strictly finite expiry: infinite expiration tokens are forbidden.
JWT_EXPIRATION_MS=86400000
